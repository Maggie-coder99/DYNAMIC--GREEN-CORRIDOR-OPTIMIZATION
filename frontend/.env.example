# Frontend (Vite)
VITE_API_URL=http://localhost:4000

# Optional: Mapbox public token. Leave empty to use free OpenStreetMap / Carto tiles (recommended for demos).
VITE_MAPBOX_TOKEN=

# Backend
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string
TOKEN_EXPIRES_IN=8h

# Optional PostgreSQL connection. If unset, the API uses the bundled JSON seed store (demo-ready).
DATABASE_URL=

# Optional Mapbox secret used only by the backend token proxy (never commit real keys).
MAPBOX_SECRET_TOKEN=
